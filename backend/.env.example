# MongoDB
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=proposal_tracker

# Auth
JWT_SECRET=<generate a long random string>

# Set to "production" when deployed (enables secure cookies)
ENVIRONMENT=production

# CORS - comma separated list of allowed origins.
# Not critical once frontend is served same-origin by this backend, but keep it
# set to your real domain(s) as a safety net.
CORS_ORIGINS=https://yourdomain.com

# Email (Resend) - optional, notifications are skipped if unset
RESEND_API_KEY=
SENDER_EMAIL=noreply@yourdomain.com

# Base URL of the deployed app - used to build clickable links in email notifications
APP_URL=https://yourdomain.com

# Zoho OAuth ("Sign in with Zoho") - optional. Leave blank to disable the Zoho login button.
# Register the app at https://api-console.zoho.com to get these.
# Redirect URI to register there: <APP_URL>/api/auth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Change this if your Zoho org is on a different data center (check which
# accounts.zoho.XX URL you use to log into Zoho CRM):
# US: https://accounts.zoho.com (default)  EU: https://accounts.zoho.eu
# India: https://accounts.zoho.in          Australia: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com

# Seed admin user created on first startup
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<change this - do not keep the default>
